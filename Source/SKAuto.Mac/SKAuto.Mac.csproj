<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
   <TargetFramework>net8.0-maccatalyst</TargetFramework>
  <TargetPlatformVersion>13.1</TargetPlatformVersion>
  <SupportedOSPlatformVersion>13.1</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <ApplicationId>com.skauto.worktracking</ApplicationId>
    <ApplicationTitle>SKAuto Work Tracking</ApplicationTitle>
    <ApplicationVersion>2.0.0</ApplicationVersion>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SKAuto.Core\SKAuto.Core.csproj" />
    <ProjectReference Include="..\SKAuto.Data\SKAuto.Data.csproj" />
    <ProjectReference Include="..\SKAuto.Import\SKAuto.Import.csproj" />
    <ProjectReference Include="..\SKAuto.Export\SKAuto.Export.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include all XAML and resources from the WPF project (you may want to use shared links) -->
    <Compile Include="..\SKAuto.UI\ViewModels\*.cs" Link="ViewModels\%(FileName).cs" />
    <Compile Include="..\SKAuto.UI\Converters\*.cs" Link="Converters\%(FileName).cs" />
    <Compile Include="..\SKAuto.UI\Localization\*.cs" Link="Localization\%(FileName).cs" />
    <Compile Include="..\SKAuto.UI\Controls\*.cs" Link="Controls\%(FileName).cs" />
    <Compile Include="..\SKAuto.UI\Views\*.xaml" Link="Views\%(FileName).xaml" />
    <Page Include="..\SKAuto.UI\Views\*.xaml" Link="Views\%(FileName).xaml" />
    <!-- Include styles -->
    <Page Include="..\SKAuto.UI\Styles\*.xaml" Link="Styles\%(FileName).xaml" />
    <!-- Include resources -->
    <EmbeddedResource Include="..\SKAuto.UI\Localization\Strings.resx" Link="Localization\Strings.resx" />
    <EmbeddedResource Include="..\SKAuto.UI\Localization\Strings.fr.resx" Link="Localization\Strings.fr.resx" />
  </ItemGroup>

  <ItemGroup>
    <!-- macOS-specific icon and assets -->
    <MauiIcon Include="logo.png" />
    <MauiSplashScreen Include="splash.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="3.3.3" />
  </ItemGroup>

</Project>