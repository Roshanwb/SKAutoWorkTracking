<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseOpenSilver>true</UseOpenSilver>
    <DefineConstants>$(DefineConstants);OPENSILVER</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="3.3.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SKAuto.Core\SKAuto.Core.csproj" />
    <ProjectReference Include="..\SKAuto.Data\SKAuto.Data.csproj" />
    <ProjectReference Include="..\SKAuto.Import\SKAuto.Import.csproj" />
    <ProjectReference Include="..\SKAuto.Export\SKAuto.Export.csproj" />
  </ItemGroup>

  <!-- Mac-specific App files -->
  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="Services\MacDispatcherService.cs" />
    <Compile Include="Services\MacMessageBoxService.cs" />
    <Page Include="App.xaml" />
    <Compile Include="Program.cs" />
    <Compile Include="PlatformStubs.cs" />
  </ItemGroup>

  <!-- Shared files from SKAuto.UI -->
  <ItemGroup>
    <Compile Include="..\SKAuto.UI\ViewModels\*.cs" Link="ViewModels\%(FileName).cs" />
    <Compile Include="..\SKAuto.UI\Converters\*.cs" Link="Converters\%(FileName).cs" />
    <Compile Include="..\SKAuto.UI\Localization\*.cs" Link="Localization\%(FileName).cs" />
    <Compile Include="..\SKAuto.UI\Controls\*.cs" Link="Controls\%(FileName).cs" />
  </ItemGroup>

  <!-- Shared XAML (views and styles) -->
  <ItemGroup>
    <Page Include="..\SKAuto.UI\Views\*.xaml" Link="Views\%(FileName).xaml" />
    <Page Include="..\SKAuto.UI\Styles\*.xaml" Link="Styles\%(FileName).xaml" />
  </ItemGroup>

  <!-- Shared resources (localization) -->
  <ItemGroup>
    <EmbeddedResource Include="..\SKAuto.UI\Localization\Strings.resx" Link="Localization\Strings.resx" />
    <EmbeddedResource Include="..\SKAuto.UI\Localization\Strings.fr.resx" Link="Localization\Strings.fr.resx" />
  </ItemGroup>

</Project>