<Window x:Class="SKAuto.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"       
        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SKAuto.UI.Converters"
        mc:Ignorable="d"
        Title="{loc:Translate MainWindow_Title}" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding CreateWorkOrderCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <!-- Converters -->
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:BillingStatusToColorConverter x:Key="BillingStatusToColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisibilityConverter"/>

        <!-- Icon button base -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F51B5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action button (right panel) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small status buttons -->
        <Style x:Key="StatusButton" BasedOn="{StaticResource ActionButton}" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- DataGrid header -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="#1A252F"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- ===== MENU ===== -->
        <Menu DockPanel.Dock="Top" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="{loc:Translate MainWindow_File}">
                <MenuItem Header="{loc:Translate MainWindow_Import}" Command="{Binding ImportDataCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Translate MainWindow_ChangePassword}" Command="{Binding ChangePasswordCommand}"/>
                <MenuItem Header="{loc:Translate MainWindow_Settings}" Command="{Binding OpenSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Translate MainWindow_Exit}"/>
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow_Manage}" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="{loc:Translate MainWindow_Clients}" Command="{Binding OpenClientManagementCommand}"/>
                <MenuItem Header="{loc:Translate MainWindow_Vehicles}" Command="{Binding OpenVehicleManagementCommand}"/>
                <MenuItem Header="{loc:Translate MainWindow_Tasks}" Command="{Binding ShowAccessoryManagementCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Translate MainWindow_Users}" Command="{Binding ShowUserManagementCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Translate MainWindow_BulkPriceUpdate}" Command="{Binding OpenPriceUpdateCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow_Reports}">
                <MenuItem Header="{loc:Translate MainWindow_GenerateReport}" Command="{Binding OpenReportsCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow_Admin}" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="{loc:Translate MainWindow_BackupRestore}" Command="{Binding OpenBackupCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow_Help}">
                <MenuItem Header="{loc:Translate MainWindow_Help}" Command="{Binding OpenHelpCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Translate MainWindow_About}" Command="{Binding OpenAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ===== MAIN GRID ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== TOOLBAR ===== -->
            <Border Grid.Row="0" Background="#2C3E50" Padding="8,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Command="{Binding PreviousWeekCommand}" Content="&#xeb9e;" ToolTip="{loc:Translate MainWindow_PreviousWeek}"/>
                    <Button Style="{StaticResource IconButton}" Command="{Binding PreviousDayCommand}" Content="&#xE76B;" Margin="4,0,0,0" ToolTip="{loc:Translate MainWindow_PreviousDay}"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="8,0" Background="White" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Command="{Binding NextDayCommand}" Content="&#xE76C;" Margin="0,0,4,0" ToolTip="{loc:Translate MainWindow_NextDay}"/>
                    <Button Style="{StaticResource IconButton}" Command="{Binding NextWeekCommand}" Content="&#xeb9d;" ToolTip="{loc:Translate MainWindow_NextWeek}"/>
                    <Button Content="{loc:Translate MainWindow_Refresh}" Command="{Binding LoadTodayWorkCommand}" Style="{StaticResource ActionButton}" Background="#2196F3" Width="70" Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#BDC3C7" Margin="16,0,0,0" VerticalAlignment="Center" FontStyle="Italic" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ===== MAIN CONTENT ===== -->
            <Grid Grid.Row="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Work Orders DataGrid -->
                <DataGrid Grid.Column="0"
                          ItemsSource="{Binding TodayWorkOrders}"
                          SelectedItem="{Binding SelectedWorkOrder}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          BorderThickness="1"
                          BorderBrush="#DEE2E6"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#F8F9FA"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Translate MainWindow_ID}" Binding="{Binding Id}" Width="45"/>
                        <DataGridTemplateColumn Header="{loc:Translate MainWindow_Edit}" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{loc:Translate MainWindow_EditIcon}" Command="{Binding DataContext.EditWorkOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Background="Transparent" BorderThickness="0" Foreground="#3498DB" FontSize="14" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Translate MainWindow_Client}" Binding="{Binding ClientName}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Translate MainWindow_Vehicle}" Binding="{Binding VehicleModel}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Translate MainWindow_Chassis}" Binding="{Binding VehicleChassis}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Translate ClientManagementView_Type}" Binding="{Binding OrderType}" Width="90"/>
                        <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_Status}" Binding="{Binding Status}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- NEW: Billing Status Column -->
                        <DataGridTemplateColumn Header="Billing" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BillingStatus, Converter={StaticResource BillingStatusToColorConverter}}"
                    CornerRadius="4" Padding="4,2" Margin="2,0">
                                        <TextBlock Text="{Binding BillingStatus}" Foreground="White" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- NEW: Attachments Column -->
                        <DataGridTemplateColumn Header="📎" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📎" Visibility="{Binding AttachmentCount, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" Margin="0,0,5,0" Foreground="#3498DB"/>
                                        <Button Content="📎" Command="{Binding DataContext.OpenAttachmentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand" ToolTip="Manage attachments" Foreground="#3498DB"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Translate ReportsView_Tasks}" Binding="{Binding TaskCount}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Translate MainWindow_Total}" Binding="{Binding TotalAmount, StringFormat=C}" Width="80" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <DataGridTextColumn Header="{loc:Translate MainWindow_Notes}" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ===== RIGHT PANEL ===== -->
                <StackPanel Grid.Column="1" Width="210" Margin="12,0,0,0">
                    <!-- Summary Cards -->
                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate MainWindow_Today}" FontWeight="SemiBold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalOrdersToday, StringFormat='Orders: {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding TotalRevenueToday, StringFormat='Revenue: {0:C}'}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate MainWindow_Week}" FontWeight="SemiBold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Week of {0:dd/MM}   {1:dd/MM}">
                                        <Binding Path="WeeklySummary.WeekStart"/>
                                        <Binding Path="WeeklySummary.WeekEnd"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding WeeklySummary.TotalWorkOrders, StringFormat='Total Orders: {0}'}" FontSize="11"/>
                            <TextBlock Text="{Binding WeeklySummary.TotalRevenue, StringFormat='Revenue: {0:C}'}" FontSize="11" FontWeight="SemiBold" Foreground="#27AE60"/>
                            <Expander Header="{loc:Translate MainWindow_TopClients}" IsExpanded="False" Margin="0,5,0,0" BorderBrush="#e0e0e0">
                                <ItemsControl ItemsSource="{Binding WeeklySummary.ClientSummaries}" MaxHeight="150">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="{Binding ClientName}" Width="110" TextWrapping="NoWrap" Foreground="#2c3e50"/>
                                                <TextBlock Text="{Binding OrderCount}" Width="30" HorizontalAlignment="Right" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat=C}" Width="60" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Primary Actions -->
                    <Button Content="{loc:Translate MainWindow_NewWorkOrder}" Style="{StaticResource ActionButton}" Background="#E91E63" Height="55" FontSize="15" FontWeight="Bold" Command="{Binding CreateWorkOrderCommand}"/>

                    <!-- Secondary Actions -->
                    <Button Content="{loc:Translate MainWindow_ImportData}" Style="{StaticResource ActionButton}" Background="#8BC34A" Command="{Binding ImportDataCommand}"/>
                    <Button Content="{loc:Translate ReportsView_GenerateReports}" Style="{StaticResource ActionButton}" Background="#27AE60" Command="{Binding OpenReportsCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Admin Only -->
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="{loc:Translate ClientManagementView_ManageClients}" Style="{StaticResource ActionButton}" Background="#17A2B8" Command="{Binding OpenClientManagementCommand}"/>
                        <Button Content="{loc:Translate VehicleManagementView_ManageVehicles}" Style="{StaticResource ActionButton}" Background="#17A2B8" Command="{Binding OpenVehicleManagementCommand}"/>
                    </StackPanel>

                    <!-- Status Updates -->
                    <TextBlock Text="{loc:Translate MainWindow_UpdateStatus}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,4"/>
                    <Button Content="{loc:Translate MainWindow_InProgress}" Style="{StaticResource StatusButton}" Background="#F39C12" Command="{Binding UpdateStatusCommand}" CommandParameter="InProgress"/>
                    <Button Content="{loc:Translate MainWindow_Blocked}" Style="{StaticResource StatusButton}" Background="#E74C3C" Command="{Binding UpdateStatusCommand}" CommandParameter="Blocked"/>
                    <Button Content="{loc:Translate MainWindow_Done}" Style="{StaticResource StatusButton}" Background="#2ECC71" Command="{Binding UpdateStatusCommand}" CommandParameter="Done"/>

                    <!-- NEW: Billing Status -->
                    <TextBlock Text="{loc:Translate MainWindow_Done}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,4"/>
                    <Button Content="{loc:Translate MainWindow_BillingDone}" Style="{StaticResource StatusButton}" Background="#2ECC71"        Command="{Binding UpdateBillingStatusCommand}" CommandParameter="Done"/>
                    <Button Content="{loc:Translate MainWindow_BillingToDo}" Style="{StaticResource StatusButton}" Background="#F39C12"         Command="{Binding UpdateBillingStatusCommand}" CommandParameter="ToDo"/>
                    <Button Content="{loc:Translate MainWindow_BillingPending}" Style="{StaticResource StatusButton}" Background="#E74C3C"         Command="{Binding UpdateBillingStatusCommand}" CommandParameter="Pending"/>
                    


                    <TextBlock Text="{loc:Translate MainWindow_Danger}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,4"/>
                    <Button Content="{loc:Translate MainWindow_DeleteWorkOrder}" Style="{StaticResource StatusButton}" Background="#DC3545" Command="{Binding DeleteWorkOrderCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2" Background="#F8F9FA" Padding="6,4" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="{loc:Translate MainWindow_Title}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock x:Name="VersionTextBlock" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Translate Insights}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <TextBlock Text="{Binding SyncStatus}" Margin="0,0,8,0" FontSize="11" Foreground="#7F8C8D"/>
                        <Button Content="{loc:Translate MainWindow_Drive}" Command="{Binding OpenDriveSettingsCommand}" Background="Transparent" BorderThickness="0" Foreground="#3498DB" Cursor="Hand" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>