<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== BASE BACKGROUNDS ===== -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F0F0"/>

    <!-- ===== FOREGROUNDS ===== -->
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#34495E"/>
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#95A5A6"/>
    <SolidColorBrush x:Key="PlaceholderForegroundBrush" Color="#6C757D"/>

    <!-- ===== ACCENTS ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3498DB"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F39C12"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C"/>

    <!-- ===== BORDERS ===== -->
    <SolidColorBrush x:Key="BorderBrush" Color="#DEE2E6"/>
    <SolidColorBrush x:Key="LightBorderBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="#BDC3C7"/>

    <!-- ===== CARDS ===== -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DDDDDD"/>
    <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="CardMargin">0,0,0,12</Thickness>

    <!-- ===== BUTTONS ===== -->
    <SolidColorBrush x:Key="ButtonPrimaryBackground" Color="#3498DB"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBackground" Color="#2980B9"/>
    <SolidColorBrush x:Key="ButtonPrimaryPressedBackground" Color="#1A5276"/>

    <SolidColorBrush x:Key="ButtonSuccessBackground" Color="#27AE60"/>
    <SolidColorBrush x:Key="ButtonSuccessHoverBackground" Color="#219A52"/>

    <SolidColorBrush x:Key="ButtonWarningBackground" Color="#F39C12"/>
    <SolidColorBrush x:Key="ButtonWarningHoverBackground" Color="#D68910"/>

    <SolidColorBrush x:Key="ButtonDangerBackground" Color="#E74C3C"/>
    <SolidColorBrush x:Key="ButtonDangerHoverBackground" Color="#C0392B"/>

    <SolidColorBrush x:Key="ButtonSecondaryBackground" Color="#6C757D"/>
    <SolidColorBrush x:Key="ButtonSecondaryHoverBackground" Color="#5A6268"/>

    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#E9ECEF"/>
    <SolidColorBrush x:Key="ButtonDisabledForeground" Color="#6C757D"/>

    <!-- ===== DATA GRID ===== -->
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#2C3E50"/>
    <SolidColorBrush x:Key="DataGridHeaderForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#1A252F"/>
    <SolidColorBrush x:Key="DataGridRowBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBackground" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="DataGridSelectedRowBackground" Color="#B3D4FC"/>
    <SolidColorBrush x:Key="DataGridSelectedRowForeground" Color="#2C3E50"/>
    <SolidColorBrush x:Key="DataGridRowBorderBrush" Color="#DEE2E6"/>

    <!-- ===== MENU ===== -->
    <SolidColorBrush x:Key="MenuBackground" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="MenuItemBackground" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="MenuItemHoverBackground" Color="#E9ECEF"/>
    <SolidColorBrush x:Key="MenuItemPressedBackground" Color="#DEE2E6"/>
    <SolidColorBrush x:Key="MenuItemForeground" Color="#2C3E50"/>

    <!-- ===== TOOLBAR ===== -->
    <SolidColorBrush x:Key="ToolbarBackground" Color="#2C3E50"/>
    <SolidColorBrush x:Key="ToolbarForeground" Color="#FFFFFF"/>

    <!-- ===== TEXT BOX / COMBOBOX / DATE PICKER ===== -->
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputForeground" Color="#2C3E50"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#DEE2E6"/>
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#3498DB"/>

    <!-- ===== EXPANDER ===== -->
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#2C3E50"/>

    <!-- ===== GROUP BOX ===== -->
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#DEE2E6"/>

    <!-- ===== TAB CONTROL ===== -->
    <SolidColorBrush x:Key="TabControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabItemBackground" Color="#E9ECEF"/>
    <SolidColorBrush x:Key="TabItemSelectedBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabItemForeground" Color="#2C3E50"/>
    <SolidColorBrush x:Key="TabItemBorderBrush" Color="#DEE2E6"/>

    <!-- ===== SCROLL BAR ===== -->
    <SolidColorBrush x:Key="ScrollBarBackground" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#C1C1C1"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBackground" Color="#A0A0A0"/>

    <!-- ===== TOOLTIP ===== -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolTipForeground" Color="#2C3E50"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#DEE2E6"/>

    <!-- ===== HYPERLINK ===== -->
    <SolidColorBrush x:Key="HyperlinkForeground" Color="#3498DB"/>
    <SolidColorBrush x:Key="HyperlinkHoverForeground" Color="#2980B9"/>

    <!-- ===== STATUS BAR (FOOTER) ===== -->
    <SolidColorBrush x:Key="StatusBarBackground" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="StatusBarForeground" Color="#7F8C8D"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#E0E0E0"/>

    <!-- ===== FONTS ===== -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, Verdana, Arial</FontFamily>
    <FontFamily x:Key="HeaderFontFamily">Segoe UI, Verdana, Arial</FontFamily>
    <FontFamily x:Key="TitleFontFamily">Segoe UI, Verdana, Arial</FontFamily>

    <sys:Double x:Key="HeaderFontSize">14</sys:Double>
    <sys:Double x:Key="NormalFontSize">12</sys:Double>
    <sys:Double x:Key="SmallFontSize">10</sys:Double>
    <sys:Double x:Key="TitleFontSize">18</sys:Double>
</ResourceDictionary>