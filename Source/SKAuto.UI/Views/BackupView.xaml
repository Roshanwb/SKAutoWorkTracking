<Window x:Class="SKAuto.UI.Views.BackupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup &amp; Restore" Height="500" Width="550"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Backup Section -->
        <GroupBox Header="Backup Database" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding BackupFolder}" Width="300" Margin="0,0,10,0"/>
                    <Button Content="Browse" Command="{Binding SelectBackupFolderCommand}" Padding="10,5" Margin="0,0,10,0"/>
                    <Button Content="Create Backup" Command="{Binding BackupCommand}" 
                            Style="{StaticResource ActionButton}" Background="#4CAF50" Width="100"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Export Section -->
        <GroupBox Header="Export Data to CSV/ZIP" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding ExportFolder}" Width="300" Margin="0,0,10,0"/>
                    <Button Content="Browse" Command="{Binding SelectExportFolderCommand}" Padding="10,5" Margin="0,0,10,0"/>
                    <Button Content="Export Data" Command="{Binding ExportCommand}" 
                            Style="{StaticResource ActionButton}" Background="#3498db" Width="100"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Import Section -->
        <GroupBox Header="Import from ZIP" Grid.Row="2" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Text="{Binding ImportFilePath}" Width="300" Margin="0,0,10,0" IsReadOnly="True"/>
                    <Button Content="Browse" Command="{Binding SelectImportFileCommand}" Padding="10,5" Margin="0,0,10,0"/>
                    <Button Content="Import" Command="{Binding ImportCommand}" 
                            Style="{StaticResource ActionButton}" Background="#f39c12" Width="100"/>
                </StackPanel>

                <CheckBox Content="Dry Run (preview only)" IsChecked="{Binding IsDryRun}" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Conflict resolution:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding ConflictResolutions}" 
                              SelectedItem="{Binding Conflict}" Width="100">
                        <ComboBoxItem>Skip</ComboBoxItem>
                        <ComboBoxItem>Overwrite</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="(Skip = ignore existing records, Overwrite = replace them)" 
                               FontSize="10" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Result / Log -->
        <GroupBox Header="Result" Grid.Row="3" Margin="0,0,0,10" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Close Button -->
        <Button Content="Close" Command="{Binding CloseCommand}" 
                Style="{StaticResource ActionButton}" Background="#6c757d" 
                HorizontalAlignment="Right" Width="80" Grid.Row="4"/>
    </Grid>
</Window>