<UserControl x:Class="SKAuto.UI.Views.AccessoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tasks" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" Margin="0,0,10,0" BorderBrush="#dee2e6"
                     ToolTip="Search by name, part number, or description"/>
            <Button Content="Add New Task" Padding="10,5" 
                    Command="{Binding AddAccessoryCommand}"
                    Style="{StaticResource ActionButton}" Background="#4CAF50" Height="28" Width="120"/>
        </StackPanel>

        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Accessories}"
                  SelectedItem="{Binding SelectedAccessory}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                  BorderBrush="#dee2e6" BorderThickness="1"
                  RowBackground="#ffffff" AlternatingRowBackground="#f8f9fa">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Part #" Binding="{Binding PartNumber}" Width="70"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="100"/>
                <DataGridTextColumn Header="Time (min)" Binding="{Binding Time}" Width="70"/>
                <DataGridTextColumn Header="Price (€)" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="70"/>
                <DataGridCheckBoxColumn Header="Password" Binding="{Binding RequiresPassword}" Width="70"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                <DataGridTemplateColumn Header="Actions" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Margin="2" Padding="5,2"
                                        Command="{Binding DataContext.EditAccessoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ActionButton}" Background="#3498db" Height="28" Width="70"/>
                                <Button Content="Delete" Margin="2" Padding="5,2"
                                        Command="{Binding DataContext.DeleteAccessoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ActionButton}" Background="#f44336" Height="28" Width="70"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit Panel -->
        <Border Grid.Row="3" 
                Background="#f8f9fa" 
                BorderBrush="#dee2e6" 
                BorderThickness="1" 
                Padding="10"
                CornerRadius="4"
                Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel>
                <TextBlock Text="{Binding CurrentEditAccessory.Id, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse, FallbackValue=Add New Task}" 
                           FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#2c3e50"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1 -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Name:*" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="0" Grid.Column="2" Content="Part #:" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditPartNumber}"/>

                    <!-- Row 2 -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Description:" Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditDescription}"/>

                    <!-- Row 3 -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Time (min):" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditTime}"/>

                    <Label Grid.Row="2" Grid.Column="2" Content="Price (€):" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditPrice}"/>

                    <!-- Row 4 -->
                    <Label Content="Task Type:" Grid.Row="3" Grid.Column="0" Margin="5"/>
                    <ComboBox ItemsSource="{Binding TaskTypeValues}" Grid.Row="3" Grid.Column="1" 
                              SelectedItem="{Binding EditTaskType}" VerticalAlignment="Center"
                              Margin="5" Height="30"/>
                    <CheckBox Content="Is Active" Margin="5" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                              IsChecked="{Binding EditIsActive}"/>
                    <CheckBox Grid.Row="3" Grid.Column="3" 
                              Content="Requires Password Protection" 
                              Margin="5" VerticalAlignment="Center"
                              IsChecked="{Binding EditRequiresPassword}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Content="Save" Padding="15,5" Margin="5"
                            Command="{Binding SaveAccessoryCommand}"
                            Style="{StaticResource ActionButton}" Background="#4CAF50" Width="70"/>
                    <Button Content="Cancel" Padding="15,5" Margin="5"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource ActionButton}" Background="#6c757d" Width="70"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>