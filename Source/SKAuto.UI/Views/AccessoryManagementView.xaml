<UserControl x:Class="SKAuto.UI.Views.AccessoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Accessory Catalog" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Search and Add Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" Margin="0,0,10,0"
                     ToolTip="Search by name, part number, or description"/>
            <Button Content="Add New Accessory" Padding="10,5" 
                    Command="{Binding AddAccessoryCommand}"
                    Background="#4CAF50" Foreground="White"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Accessories}"
                  SelectedItem="{Binding SelectedAccessory}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Part #" Binding="{Binding PartNumber}" Width="40"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="100"/>
                <DataGridTextColumn Header="Fitting Time (min)" Binding="{Binding StandardFittingTime}" Width="50"/>
                <DataGridTextColumn Header="PSA Rate (€/h)" Binding="{Binding PSAHourlyRate, StringFormat={}{0:F2}}" Width="50"/>
                <DataGridTextColumn Header="Selling Price (€)" Binding="{Binding SellingPrice, StringFormat={}{0:F2}}" Width="50"/>
                <DataGridCheckBoxColumn Header="Password" Binding="{Binding RequiresPassword}" Width="50"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="50"/>
                <DataGridTemplateColumn Header="Actions" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Margin="2" Padding="5,2"
                                        Command="{Binding DataContext.EditAccessoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Delete" Margin="2" Padding="5,2"
                                        Command="{Binding DataContext.DeleteAccessoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#f44336" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit Panel (visible when adding/editing) -->
        <Border Grid.Row="3" 
                Background="#f5f5f5" 
                BorderBrush="#ddd" 
                BorderThickness="1" 
                Padding="10"
                Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel>
                <TextBlock Text="{Binding CurrentEditAccessory.Id, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse, FallbackValue=Add New Accessory}" 
                           FontWeight="Bold" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1 -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Name:*" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="5" 
                             Text="{Binding CurrentEditAccessory.Name}"/>

                    <Label Grid.Row="0" Grid.Column="2" Content="Part #:" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="5" 
                             Text="{Binding CurrentEditAccessory.PartNumber}"/>

                    <!-- Row 2 -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Description:" Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" 
                             Text="{Binding CurrentEditAccessory.Description}"/>

                    <!-- Row 3 -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Fitting Time (min):" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="5" 
                             Text="{Binding CurrentEditAccessory.StandardFittingTime}"/>

                    <Label Grid.Row="2" Grid.Column="2" Content="PSA Hourly Rate (€):" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Margin="5" 
                             Text="{Binding CurrentEditAccessory.PSAHourlyRate}"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Selling Price (€):" Margin="5"/>
                    <TextBox Grid.Column="1" Margin="5" 
                             Text="{Binding CurrentEditAccessory.SellingPrice}"/>

                    <CheckBox Grid.Column="2" Grid.ColumnSpan="2" 
                              Content="Requires Password Protection" 
                              Margin="5" VerticalAlignment="Center"
                              IsChecked="{Binding CurrentEditAccessory.RequiresPassword}"/>
                </Grid>

                <CheckBox Content="Is Active" 
                          Margin="5" 
                          IsChecked="{Binding CurrentEditAccessory.IsActive}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Content="Save" Padding="15,5" Margin="5"
                            Command="{Binding SaveAccessoryCommand}"
                            Background="#4CAF50" Foreground="White"/>
                    <Button Content="Cancel" Padding="15,5" Margin="5"
                            Command="{Binding CancelEditCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>