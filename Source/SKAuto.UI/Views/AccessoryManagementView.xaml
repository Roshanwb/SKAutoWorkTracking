<UserControl x:Class="SKAuto.UI.Views.AccessoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:SKAuto.UI.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="{loc:Translate ReportsView_Tasks}" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,10"/>

        <!-- PSA Rate (Admin only) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Label Content="PSA Rate (Eur/h)" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <TextBox Text="{Binding PsaRate, UpdateSourceTrigger=PropertyChanged}" 
                     Width="80" Height="25" VerticalAlignment="Center" BorderBrush="#dee2e6"
                     ToolTip="Enter the PSA hourly rate (automatically saved)"/>
            <TextBlock Text=" (auto-saved)" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#6c757d" FontSize="11"/>
        </StackPanel>

        <!-- Search and Add -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" Margin="0,0,10,0" BorderBrush="#dee2e6"
                     ToolTip="{loc:Translate AccessoryManagementView_SearchHint}"/>
            <Button Content="{loc:Translate AccessoryManagementView_AddNewTask}" Padding="10,5" 
                    Command="{Binding AddAccessoryCommand}"
                    Style="{StaticResource ActionButton}" Background="#4CAF50" Height="28" Width="120"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding Accessories}"
                  SelectedItem="{Binding SelectedAccessory}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                  BorderBrush="#dee2e6" BorderThickness="1"
                  RowBackground="#ffffff" AlternatingRowBackground="#f8f9fa">

            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Translate AccessoryManagementView_Name}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{loc:Translate AccessoryManagementView_PartNumber}" Binding="{Binding PartNumber}" Width="70"/>
                <DataGridTextColumn Header="{loc:Translate AccessoryManagementView_Description}" Binding="{Binding Description}" Width="100"/>
                <DataGridTextColumn Header="{loc:Translate AccessoryManagementView_TimeMin}" Binding="{Binding Time}" Width="70"/>
                <DataGridTextColumn Header="{loc:Translate AccessoryManagementView_Price}" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="70"/>
                <DataGridCheckBoxColumn Header="{loc:Translate LoginView_Password}" Binding="{Binding RequiresPassword}" Width="70"/>
                <DataGridCheckBoxColumn Header="{loc:Translate VehicleManagementView_Active}" Binding="{Binding IsActive}" Width="70"/>
                <DataGridTemplateColumn Header="{loc:Translate AccessoryManagementView_Actions}" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Translate MainWindow_Edit}" Margin="2" Padding="5,2"
                                        Command="{Binding DataContext.EditAccessoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ActionButton}" Background="#3498db" Height="28" Width="70"/>
                                <Button Content="{loc:Translate ClientManagementView_Delete}" Margin="2" Padding="5,2"
                                        Command="{Binding DataContext.DeleteAccessoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ActionButton}" Background="#f44336" Height="28" Width="70"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit Panel -->
        <Border Grid.Row="4" 
                Background="#f8f9fa" 
                BorderBrush="#dee2e6" 
                BorderThickness="1" 
                Padding="10"
                CornerRadius="4"
                Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel>
                <TextBlock Text="{Binding CurrentEditAccessory.Id, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse, FallbackValue=Add New Task}" 
                           FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#2c3e50"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1 -->
                    <Label Grid.Row="0" Grid.Column="0" Content="{loc:Translate AccessoryManagementView_NameRequired}" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="0" Grid.Column="2" Content="{loc:Translate AccessoryManagementView_PartNumberLabel}" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditPartNumber}"/>

                    <!-- Row 2 -->
                    <Label Grid.Row="1" Grid.Column="0" Content="{loc:Translate AccessoryManagementView_DescriptionLabel}" Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditDescription}"/>

                    <!-- Row 3 -->
                    <Label Grid.Row="2" Grid.Column="0" Content="{loc:Translate AccessoryManagementView_TimeMinLabel}" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditTime}"/>

                    <Label Grid.Row="2" Grid.Column="2" Content="{loc:Translate AccessoryManagementView_PriceLabel}" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Margin="5" BorderBrush="#dee2e6"
                             Text="{Binding EditPrice}"/>

                    <!-- Row 4 -->
                    <Label Content="{loc:Translate ReportsView_TaskType}" Grid.Row="3" Grid.Column="0" Margin="5"/>
                    <ComboBox ItemsSource="{Binding TaskTypeValues}" Grid.Row="3" Grid.Column="1" 
                              SelectedItem="{Binding EditTaskType}" VerticalAlignment="Center"
                              Margin="5" Height="30"/>
                    <CheckBox Content="{loc:Translate AccessoryManagementView_IsActive}" Margin="5" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                              IsChecked="{Binding EditIsActive}"/>
                    <CheckBox Grid.Row="3" Grid.Column="3" 
                              Content="{loc:Translate AccessoryManagementView_RequiresPassword}" 
                              Margin="5" VerticalAlignment="Center"
                              IsChecked="{Binding EditRequiresPassword}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Content="{loc:Translate VehicleEditWindow_Save}" Padding="15,5" Margin="5"
                            Command="{Binding SaveAccessoryCommand}"
                            Style="{StaticResource ActionButton}" Background="#4CAF50" Width="70"/>
                    <Button Content="{loc:Translate VehicleEditWindow_Cancel}" Padding="15,5" Margin="5"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource ActionButton}" Background="#6c757d" Width="70"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>