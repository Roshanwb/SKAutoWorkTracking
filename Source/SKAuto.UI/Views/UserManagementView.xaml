<Window x:Class="SKAuto.UI.Views.UserManagementView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Translate UserManagementView_ManageUsers}" Height="400" Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                  BorderBrush="#dee2e6" BorderThickness="1"
                  RowBackground="#ffffff" AlternatingRowBackground="#f8f9fa">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Translate MainWindow_ID}" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="{loc:Translate LoginView_Username}" Binding="{Binding Username}" Width="*" SortDirection="Ascending"/>
                <DataGridTextColumn Header="{loc:Translate UserManagementView_Role}" Binding="{Binding Role}" Width="80"/>
                <DataGridCheckBoxColumn Header="{loc:Translate VehicleManagementView_Active}" Binding="{Binding IsActive}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Translate UserManagementView_Add}" Command="{Binding AddUserCommand}" 
                    Style="{StaticResource ActionButton}" Background="#4CAF50"
                    Width="80" Margin="5"/>
            <Button Content="{loc:Translate MainWindow_Edit}" Command="{Binding EditUserCommand}" 
                    Style="{StaticResource ActionButton}" Background="#3498db"
                    Width="80" Margin="5"/>
            <Button Content="{loc:Translate ClientManagementView_Delete}" Command="{Binding DeleteUserCommand}" 
                    Style="{StaticResource ActionButton}" Background="#dc3545"
                    Width="80" Margin="5"/>
            <Button Content="{loc:Translate ClientManagementView_Close}" Command="{Binding CloseCommand}" 
                    Style="{StaticResource ActionButton}" Background="#6c757d"
                    Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>