<Window x:Class="SKAuto.UI.Views.WorkOrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SKAuto.UI.Converters"
        Title="Work Order Details" Height="700" Width="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:VehicleDisplayConverter x:Key="VehicleDisplayConverter"/>
        <CollectionViewSource x:Key="SortedAccessoriesViewSource" Source="{Binding AvailableAccessories}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Name" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#004C99"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Work Order Info GroupBox -->
        <GroupBox Grid.Row="0" Header="Work Order Info" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Client:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" 
                  ItemsSource="{Binding Clients}"
                  SelectedItem="{Binding SelectedClient}"
                  DisplayMemberPath="Name"
                  Margin="5,5,0,5" Height="30" MinWidth="300"
                  IsEditable="True"
                  HorizontalAlignment="Left"/>

                <Label Grid.Row="0" Grid.Column="2" Content="Order Date:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <DatePicker Grid.Row="0" Grid.Column="3" 
                    SelectedDate="{Binding WorkOrder.OrderDate}"
                    Margin="5" Height="30" MinWidth="300"
                    HorizontalAlignment="Left"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Chassis:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="ChassisTextBox" 
                     Text="{Binding ChassisSearch, UpdateSourceTrigger=PropertyChanged}" 
                     Width="150" Margin="5" Height="30" CharacterCasing="Upper" 
                     TextOptions.TextRenderingMode="Auto" BorderBrush="#dee2e6"
                     KeyDown="ChassisTextBox_KeyDown" TabIndex="0"/>
                    <Button Content="Search" Command="{Binding SearchVehicleCommand}" 
                    Style="{StaticResource ActionButton}" Background="#3498db"
                    Width="70" Height="30" Margin="5" VerticalAlignment="Center" />
                </StackPanel>

                <Label Grid.Row="1" Grid.Column="2" Content="Selected Vehicle:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Grid.Row="1" Grid.Column="3" 
                Command="{Binding OpenVehicleEditCommand}"
                Style="{StaticResource LinkButtonStyle}"
                VerticalAlignment="Center" Margin="5">
                    <TextBlock Text="{Binding SelectedVehicle, Converter={StaticResource VehicleDisplayConverter}}" 
                       TextDecorations="Underline" Cursor="Hand"/>
                </Button>

                <Label Grid.Row="2" Grid.Column="0" Content="Order Type:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" 
                  ItemsSource="{Binding OrderTypeValues}"
                  SelectedItem="{Binding WorkOrder.OrderType}"                          
                  Margin="5" Height="30" MinWidth="300"
                  IsEditable="True"
                  HorizontalAlignment="Left"/>

                <Label Grid.Row="2" Grid.Column="2" Content="Status:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ComboBox Grid.Row="2" Grid.Column="3" 
                  ItemsSource="{Binding WorkStatusValues}"
                  SelectedItem="{Binding WorkOrder.Status}"                          
                  Margin="5" Height="30" MinWidth="200"
                  IsEditable="True"
                  HorizontalAlignment="Left"/>
            </Grid>
        </GroupBox>

        <!-- Add Task GroupBox -->
        <!-- Add Task GroupBox -->
        <GroupBox Grid.Row="1" Header="Add Task" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Task Label -->
                <Label Grid.Column="0" Content="Task:" VerticalAlignment="Center"/>

                <!-- Task ComboBox -->
                <ComboBox Grid.Column="1" 
                  ItemsSource="{Binding Source={StaticResource SortedAccessoriesViewSource}}"
                  SelectedItem="{Binding SelectedAccessory}"
                  DisplayMemberPath="Name"
                  Margin="5" Height="30"
                  HorizontalAlignment="Left"
                  IsEditable="True" Width="250"/>
                <!-- Add Button -->
                <Button Grid.Column="2" Content="Add" Command="{Binding AddTaskCommand}" 
                Style="{StaticResource ActionButton}" Background="#2196F3"
                Width="60" Height="30" Margin="5"/>
                
                <!-- + Button to add new task -->
                <Button Grid.Column="3" Content="Add New Task Name" Command="{Binding OpenAddTaskCommand}"
                Style="{StaticResource ActionButton}" Background="#4CAF50"
                FontSize="12" FontWeight="Normal" Width="120" Height="30" Margin="5"/>


                <Label Grid.Column="4" Content="" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Tasks GroupBox -->
        <GroupBox Grid.Row="2" Header="Tasks" Margin="0,0,0,10" Padding="10">
            <DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" CanUserAddRows="False" Height="200"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                      BorderBrush="#dee2e6" BorderThickness="1"
                      RowBackground="#ffffff" AlternatingRowBackground="#f8f9fa">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Accessory" Binding="{Binding Accessory.Name}" Width="*" SortDirection="Ascending"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TaskType}" Width="80"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="80"/>
                    <DataGridTextColumn Header="Est. Minutes" Binding="{Binding EstimatedMinutes}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding TaskStatus}" Width="80"/>
                    <DataGridTemplateColumn Header="Action" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" 
                                        Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource StatusButton}" Background="#F44336"
                                        FontSize="10" Padding="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Delete" Command="{Binding DeleteCommand}" 
                    Style="{StaticResource ActionButton}" Background="#F44336"
                    Width="80" Height="35" Margin="5"/>
            <Button Content="Save" Command="{Binding SaveCommand}" 
                    Style="{StaticResource ActionButton}" Background="#4CAF50"
                    Width="80" Height="35" Margin="5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" 
                    Style="{StaticResource ActionButton}" Background="#6c757d"
                    Width="80" Height="35" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>