<Window x:Class="SKAuto.UI.Views.WorkOrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SKAuto.UI.Converters"
        Title="{loc:Translate WorkOrderDetailWindow_WorkOrderDetails}" Height="750" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <converters:VehicleDisplayConverter x:Key="VehicleDisplayConverter"/>
        <CollectionViewSource x:Key="SortedAccessoriesViewSource" Source="{Binding AvailableAccessories}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Name" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <!-- Button styles -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#17A2B8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#3498DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for time up/down buttons -->
        <Style x:Key="TimeArrowButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C0C0C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Work Order Info -->
        <GroupBox Grid.Row="0" Header="{loc:Translate WorkOrderDetailWindow_WorkOrderInfo}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="{loc:Translate MainWindow_Client}" Target="{Binding ElementName=ClientCombo}" 
                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="ClientCombo" Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                          DisplayMemberPath="Name" IsEditable="True"
                          Height="30" Margin="0,4,12,4" TabIndex="5"/>

                <Label Grid.Row="0" Grid.Column="2" Content="{loc:Translate WorkOrderDetailWindow_OrderDate}" Target="{Binding ElementName=OrderDatePicker}"
                       Margin="12,0,8,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="OrderDatePicker" Grid.Row="0" Grid.Column="3"
                            SelectedDate="{Binding WorkOrder.OrderDate}"
                            Height="30" Margin="0,4,0,4" TabIndex="2"/>

                <Label Grid.Row="1" Grid.Column="0" Content="{loc:Translate MainWindow_Chassis}" Target="{Binding ElementName=ChassisTextBox}"
                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,12,4">
                    <TextBox x:Name="ChassisTextBox" Text="{Binding ChassisSearch, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Height="30" CharacterCasing="Upper"
                             KeyDown="ChassisTextBox_KeyDown" TabIndex="0"/>
                    <Button Content="{loc:Translate WorkOrderDetailWindow_Search}" Command="{Binding SearchVehicleCommand}"
                            Style="{StaticResource PrimaryButton}" Width="70" Height="30" Margin="8,0,0,0" TabIndex="1"/>
                </StackPanel>

                <Label Grid.Row="1" Grid.Column="2" Content="{loc:Translate WorkOrderDetailWindow_SelectedVehicle}" Target="{Binding ElementName=VehicleLink}"
                       Margin="12,0,8,0" VerticalAlignment="Center"/>
                <Button x:Name="VehicleLink" Grid.Row="1" Grid.Column="3"
                        Command="{Binding OpenVehicleEditCommand}" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="0,4,0,4" TabIndex="6">
                    <TextBlock Text="{Binding SelectedVehicle, Converter={StaticResource VehicleDisplayConverter}}"/>
                </Button>

                <Label Grid.Row="2" Grid.Column="0" Content="{loc:Translate WorkOrderDetailWindow_OrderType}" Target="{Binding ElementName=OrderTypeCombo}"
                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="OrderTypeCombo" Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding OrderTypeValues}" SelectedItem="{Binding WorkOrder.OrderType}"
                          Height="30" Margin="0,4,12,4" TabIndex="7"/>

                <Label Grid.Row="2" Grid.Column="2" Content="{loc:Translate WorkOrderDetailWindow_Status}" Target="{Binding ElementName=StatusCombo}"
                       Margin="12,0,8,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="StatusCombo" Grid.Row="2" Grid.Column="3"
                          ItemsSource="{Binding WorkStatusValues}" SelectedItem="{Binding WorkOrder.Status}"
                          Height="30" Margin="0,4,0,4" TabIndex="8"/>
            </Grid>
        </GroupBox>

        <!-- Add Items Toolbar (with Time & Price) -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="4" Padding="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Label Content="{loc:Translate WorkOrderDetailWindow_Task}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="TaskCombo" Width="200" Height="30"
                          ItemsSource="{Binding FilteredAccessories}"
                          Text="{Binding AccessorySearchText, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          SelectedItem="{Binding SelectedAccessory}"
                          DisplayMemberPath="Name"
                          TabIndex="3"/>

                <Label Content="{loc:Translate WorkOrderDetailWindow_Time}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TimeTextBox" Text="{Binding TaskMinutes, UpdateSourceTrigger=PropertyChanged}" 
                             Width="50" Height="30" TextAlignment="Right" TabIndex="4"
                             VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#EEEEEE"
                             ToolTip="{loc:Translate WorkOrderDetailWindow_TimeToolTip}"/>
                    <StackPanel Orientation="Vertical" Margin="2,0,0,0">
                        <Button Content="▲" Command="{Binding IncrementTimeCommand}" Style="{StaticResource TimeArrowButton}" TabIndex="-1"/>
                        <Button Content="▼" Command="{Binding DecrementTimeCommand}" Style="{StaticResource TimeArrowButton}" TabIndex="-1"/>
                    </StackPanel>
                </StackPanel>

                <Label Content="{loc:Translate WorkOrderDetailWindow_Price}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <TextBox x:Name="PriceTextBox" Text="{Binding TaskPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" 
                         Width="80" Height="30" TextAlignment="Right" TabIndex="5"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#EEEEEE"
                         ToolTip="{loc:Translate WorkOrderDetailWindow_PriceToolTip}"/>

                <Button Content="{loc:Translate WorkOrderDetailWindow_AddTask}" Command="{Binding AddTaskCommand}" 
                        Style="{StaticResource PrimaryButton}" Width="80" Height="30" Margin="8,0,0,0" TabIndex="6"/>
                <Button Content="{loc:Translate WorkOrderDetailWindow_NewTask}" Command="{Binding OpenAddTaskCommand}"
                        Style="{StaticResource SuccessButton}" Width="80" Height="30" Margin="8,0,0,0" TabIndex="7"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>
                <Button Content="{loc:Translate WorkOrderDetailWindow_AddTravel}" Command="{Binding AddTravelCommand}"
                        Style="{StaticResource InfoButton}" Width="80" Height="30" TabIndex="8"/>
            </StackPanel>
        </Border>

        <!-- ===== NEW: Attachments Group ===== -->
        <GroupBox Grid.Row="2" Header="Attachments">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Add File..." Command="{Binding AddAttachmentCommand}" Background="#3498DB" Width="100" Style="{StaticResource ActionButton}" Height="28"/>
                    <Button Content="Delete" Command="{Binding RemoveAttachmentCommand}" CommandParameter="{Binding SelectedAttachment}" Background="#E74C3C" Width="80" Margin="5,0,0,0" Style="{StaticResource ActionButton}" Height="28"/>
                    <Button Content="Download" Command="{Binding DownloadAttachmentCommand}" CommandParameter="{Binding SelectedAttachment}" Background="#2ECC71" Width="80" Margin="5,0,0,0" Style="{StaticResource ActionButton}" Height="28"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          BorderBrush="#DEE2E6" BorderThickness="1"
                          MaxHeight="120" VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Filename" Binding="{Binding OriginalFilename}" Width="*"/>
                        <DataGridTextColumn Header="Size (KB)" Binding="{Binding FileSize, StringFormat={}{0:N0}}" Width="70"/>
                        <DataGridTextColumn Header="Uploaded" Binding="{Binding UploadDate, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </GroupBox>

        <!-- Tasks & Travels -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="{loc:Translate ReportsView_Tasks}">
                <DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" CanUserAddRows="False"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          BorderBrush="#E0E0E0" BorderThickness="1"
                          RowBackground="White" AlternatingRowBackground="#F9F9F9"
                          GridLinesVisibility="Horizontal" VerticalAlignment="Stretch">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_Accessory}" Binding="{Binding Accessory.Name}" Width="*" SortDirection="Ascending"/>
                        <DataGridTextColumn Header="{loc:Translate ClientManagementView_Type}" Binding="{Binding TaskType}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_Qty}" Binding="{Binding Quantity}" Width="50"/>
                        <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_Price}" Binding="{Binding Price, StringFormat=C}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_EstMin}" Binding="{Binding EstimatedMinutes}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_Status}" Binding="{Binding TaskStatus}" Width="80"/>
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="x" 
                                            Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Foreground="#E74C3C"
                                            FontSize="14" Cursor="Hand" ToolTip="{loc:Translate WorkOrderDetailWindow_Remove}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <GroupBox Grid.Row="2" Header="{loc:Translate WorkOrderDetailWindow_Travels}">
                <DataGrid ItemsSource="{Binding Travels}" AutoGenerateColumns="False" CanUserAddRows="False"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          BorderBrush="#E0E0E0" BorderThickness="1"
                          RowBackground="White" AlternatingRowBackground="#F9F9F9"
                          GridLinesVisibility="Horizontal" MaxHeight="160" VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Translate ImportView_Date}" Binding="{Binding TravelDate, StringFormat=dd/MM/yyyy}" Width="80" SortDirection="Descending"/>
                        <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_Destination}" Binding="{Binding Destination}" Width="*"/>
                        <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_Distance}" Binding="{Binding DistanceKm}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_Cost}" Binding="{Binding TravelCost, StringFormat=C}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Translate MainWindow_Notes}" Binding="{Binding Notes}" Width="120"/>
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="?" 
                                            Command="{Binding DataContext.RemoveTravelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Foreground="#E74C3C"
                                            FontSize="14" Cursor="Hand" ToolTip="{loc:Translate WorkOrderDetailWindow_Remove}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Translate ClientManagementView_Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"
                    Width="80" Height="34" Margin="5,0" TabIndex="9"/>
            <Button Content="{loc:Translate VehicleEditWindow_Save}" Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}"
                    Width="80" Height="34" Margin="5,0" TabIndex="10"/>
            <Button Content="{loc:Translate VehicleEditWindow_Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource ActionButton}"
                    Background="#95A5A6" Width="80" Height="34" Margin="5,0" TabIndex="11"/>
        </StackPanel>
    </Grid>
</Window>