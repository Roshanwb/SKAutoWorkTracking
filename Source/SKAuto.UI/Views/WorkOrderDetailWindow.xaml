<Window x:Class="SKAuto.UI.Views.WorkOrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SKAuto.UI.Views"
        mc:Ignorable="d"
        Title="Work Order Details" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Client:" FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorkOrder.Client.Name}" Margin="5"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Vehicle:" FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding WorkOrder.Vehicle.Model}" Margin="5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Chassis:" FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WorkOrder.Vehicle.ChassisNumber}" Margin="5"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Status:" FontWeight="Bold" Margin="5"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding WorkOrder.Status}" Margin="5"/>
            </Grid>
        </Border>

        <!-- Add Task Section -->
        <GroupBox Grid.Row="1" Header="Add Task" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Accessory:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding AvailableAccessories}"
                          SelectedItem="{Binding SelectedAccessory}"
                          DisplayMemberPath="Name"
                          Margin="5" Height="30"/>

                <Label Grid.Column="2" Content="Qty:" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBox Grid.Column="3" Text="{Binding Quantity}" Width="50" Margin="5" Height="30" VerticalContentAlignment="Center"/>

                <Button Grid.Column="4" Content="Add" Command="{Binding AddTaskCommand}" 
                        Width="60" Height="30" Margin="5" Background="#2196F3" Foreground="White"/>
            </Grid>
        </GroupBox>

        <!-- Tasks List -->
        <GroupBox Grid.Row="2" Header="Tasks" Margin="0,0,0,10" Padding="10">
            <DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" CanUserAddRows="False" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Accessory" Binding="{Binding Accessory.Name}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TaskType}" Width="80"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="80"/>
                    <DataGridTextColumn Header="Est. Minutes" Binding="{Binding EstimatedMinutes}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding TaskStatus}" Width="80"/>
                    <DataGridTemplateColumn Header="Action" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" 
                                        Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="#F44336" Foreground="White" FontSize="10" Padding="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Height="35" Margin="5" Background="#4CAF50" Foreground="White"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" Height="35" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>