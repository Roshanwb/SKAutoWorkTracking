<Window x:Class="SKAuto.UI.Views.ReportsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SKAuto.UI.ViewModels"
        xmlns:converters="clr-namespace:SKAuto.UI.Converters"
        mc:Ignorable="d"
        Title="Reports" Height="600" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5">

    <Window.Resources>
        <converters:NullableEnumToStringConverter x:Key="NullableEnumToStringConverter"/>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="StatusButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Report Type -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Date Range -->
            <RowDefinition Height="*"/>
            <!-- 3: Filters (takes remaining space) -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Status Message -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Generate Reports" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Report Type Card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Report Type" Style="{StaticResource SectionHeader}"/>
                <RadioButton Content="Work Orders" IsChecked="{Binding SelectedReportType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=WorkOrders}" Margin="5,0,0,5"/>
                <RadioButton Content="Clients" IsChecked="{Binding SelectedReportType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Clients}" Margin="5,0,0,5"/>
                <RadioButton Content="Vehicles" IsChecked="{Binding SelectedReportType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Vehicles}" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Date Range Card (only for Work Orders) -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}"
                Visibility="{Binding SelectedReportType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=WorkOrders}">
            <StackPanel>
                <TextBlock Text="Date Range" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="From:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Margin="0,0,10,0"/>
                    <Label Grid.Column="2" Content="To:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Filters Card (only for Work Orders) -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}"
                Visibility="{Binding SelectedReportType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=WorkOrders}" Margin="0,5,0,5" Grid.RowSpan="3">
            <StackPanel>
                <TextBlock Text="Filters" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Task Type & Status -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Task Type:" Margin="0,5,5,5" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding TaskTypeOptions}"
                              SelectedItem="{Binding SelectedTaskTypeOption}"
                              DisplayMemberPath="Display"
                              Margin="0,5,10,5" MinWidth="120"/>

                    <Label Grid.Row="0" Grid.Column="2" Content="Status:" Margin="0,5,5,5" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="3"
                              ItemsSource="{Binding WorkStatusOptions}"
                              SelectedItem="{Binding SelectedWorkStatusOption}"
                              DisplayMemberPath="Display"
                              Margin="0,5,0,5" MinWidth="120"/>

                    <!-- Row 1: Accessory (Task) -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Task:" Margin="0,5,5,5" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding AccessoryOptions}"
                              SelectedItem="{Binding SelectedAccessoryOption}"
                              DisplayMemberPath="Display"
                              Margin="0,5,10,5" MinWidth="120" Grid.ColumnSpan="3"/>

                    <!-- Row 2: Group by Week -->
                    <CheckBox Grid.Row="2" Grid.ColumnSpan="4" Content="Group by Week" IsChecked="{Binding GroupByWeek}" Margin="5,5,0,5"/>

                    <!-- Row 3: Summary Only -->
                    <CheckBox Grid.Row="3" Grid.ColumnSpan="4" Content="Summary Only (hide details)" IsChecked="{Binding SummaryOnly}" Margin="5,0,0,5"/>
                    <!-- Row 4: Status Message Row -->
                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" 
                   Foreground="#27ae60" 
                   Margin="0,10,0,5" 
                   MinHeight="30"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Grid.ColumnSpan="4" />
                    <!-- Row 5: Action Buttons -->
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="Generate Excel" Command="{Binding GenerateExcelCommand}"
                    Style="{StaticResource  ActionButton}" Background="#27ae60" Width="120" Margin="5"/>
                        <Button Content="Generate PDF" Command="{Binding GeneratePdfCommand}"
                    Style="{StaticResource ActionButton}" Background="#e67e22" Width="120" Margin="5"/>
                        <Button Content="Close" Command="{Binding CloseCommand}"
                    Style="{StaticResource ActionButton}" Background="#6c757d" Width="80" Margin="5"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>




    </Grid>
</Window>