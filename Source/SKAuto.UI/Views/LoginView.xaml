<Window x:Class="SKAuto.UI.Views.LoginView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Translate LoginView_Login}" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="310" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentColor" Color="#3498DB"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="{StaticResource PrimaryColor}" BorderThickness="2">
        <Grid Margin="20,20,20,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Logo and Title -->
                <RowDefinition Height="Auto"/>
                <!-- Sign in text -->
                <RowDefinition Height="Auto"/>
                <!-- Username row -->
                <RowDefinition Height="Auto"/>
                <!-- Password row -->
                <RowDefinition Height="Auto"/>
                <!-- Error message -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
                <RowDefinition Height="Auto"/>
                <!-- Forgot password -->
                <RowDefinition Height="*"/>
                <!-- Footer spacing -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Image Source="/Views/logo.png" Width="80" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" VerticalAlignment="Bottom"/>
                <TextBlock Text="{loc:Translate LoginView_WorkTracking}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Top"/>
            </StackPanel>

            <!-- Sign in text -->
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{loc:Translate LoginView_SignInToContinue}" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Username -->
            <Label Grid.Row="2" Grid.Column="0" Content="{loc:Translate LoginView_Username}" Foreground="{StaticResource PrimaryColor}" Margin="0,5,10,0" VerticalAlignment="Center"/>
            <TextBox x:Name="UsernameBox" Grid.Row="2" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,5,0,10" BorderBrush="#BDC3C7" BorderThickness="1" Padding="5,0,0,0" VerticalContentAlignment="Center"/>

            <!-- Password -->
            <Label Grid.Row="3" Grid.Column="0" Content="{loc:Translate LoginView_Password}" Foreground="{StaticResource PrimaryColor}" Margin="0,5,10,0" VerticalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,5,0,10" BorderBrush="#BDC3C7" BorderThickness="1" Padding="5,0,0,0" VerticalContentAlignment="Center" PasswordChanged="PasswordBox_PasswordChanged"/>

            <!-- Error message -->
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="#E74C3C" HorizontalAlignment="Center" Margin="0,5,0,5" FontSize="8" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,5">
                <Button Content="{loc:Translate LoginView_Login}" Command="{Binding LoginCommand}" Width="100" Height="32" 
                        Style="{StaticResource ActionButton}" Background="#17A2B8" Foreground="White" BorderThickness="0" 
                        Cursor="Hand" Margin="5"/>
                <Button Content="{loc:Translate VehicleEditWindow_Cancel}" IsCancel="True" Width="100" Height="32" 
                        Style="{StaticResource ActionButton}" Background="#6c757d" Foreground="White" BorderThickness="0" 
                        Cursor="Hand" Margin="5"/>
            </StackPanel>

            <!-- Forgot Password link -->
            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{loc:Translate LoginView_ForgotPassword}" 
                       Foreground="#3498DB" HorizontalAlignment="Center" 
                       Margin="0,2,0,5" FontSize="11" Cursor="Hand"
                       TextDecorations="Underline"
                       MouseDown="ForgotPassword_Click">
                <TextBlock.ToolTip>
                    <ToolTip>Reset your password via email</ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>

            <!-- Footer -->
            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{loc:Translate Splash_Copyright}" FontSize="11" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Bottom"/>
        </Grid>
    </Border>
</Window>