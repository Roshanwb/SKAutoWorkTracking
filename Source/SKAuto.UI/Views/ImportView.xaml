<Window x:Class="SKAuto.UI.Views.ImportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SKAuto.UI.Views"
        Title="Import PDF Work Orders" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Folder selection -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Select Folder" Command="{Binding SelectFolderCommand}"
                    Padding="10,5" Width="120"/>
            <TextBlock Text="{Binding SelectedFolder}" Margin="10,0,0,0"
                       VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- Status message -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,0,0,10"
                   Foreground="Gray" FontStyle="Italic"/>

        <!-- Preview grid -->
        <DataGrid x:Name="PreviewGrid" Grid.Row="2"
                  ItemsSource="{Binding PreviewOrders}"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  Margin="0,0,0,10"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Import" Command="{Binding ImportCommand}"
                    Padding="10,5" Width="100" Margin="0,0,10,0"
                    IsEnabled="{Binding HasItems, ElementName=PreviewGrid}"/>
            <Button Content="Cancel" IsCancel="True" Padding="10,5" Width="100"/>
        </StackPanel>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="4" IsIndeterminate="{Binding IsImporting}"
                     Height="5" Margin="0,10,0,0"
                     Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>