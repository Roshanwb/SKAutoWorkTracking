<Window x:Class="SKAuto.UI.Views.ImportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SKAuto.UI.Converters"
        Title="Import Work Orders" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DateVisibilityConverter x:Key="DateVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Select PDF Folder" Command="{Binding SelectFolderCommand}" 
                    Style="{StaticResource ActionButton}" Background="#17a2b8"
                    Width="120" Margin="0,0,10,0"/>
            <Button Content="Select Excel/CSV File" Command="{Binding SelectImportFileCommand}" 
                    Style="{StaticResource ActionButton}" Background="#6c757d"
                    Width="140" Margin="0,0,10,0"/>
            <Button Content="Clear All" Command="{Binding ClearAllCommand}" 
                    Style="{StaticResource ActionButton}" Background="#dc3545"
                    Width="80"/>
            <TextBlock Text="{Binding SelectedFolder}" Margin="10,0,0,0" 
                       VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- Status message -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,0,0,10" 
                   Foreground="Gray" FontStyle="Italic"/>

        <!-- Preview grid -->
        <DataGrid x:Name="PreviewGrid" Grid.Row="2" 
                  ItemsSource="{Binding PreviewOrders}" 
                  AutoGenerateColumns="False"
                  Margin="0,0,0,10" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                  BorderBrush="#dee2e6" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Select" 
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                        Width="50"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="60"/>
                <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, Converter={StaticResource DateVisibilityConverter}}" Width="80" SortDirection="Descending"/>
                <DataGridTextColumn Header="Chassis" Binding="{Binding Chassis}" Width="150"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Select and Import buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
            <CheckBox Content="Select All" IsChecked="{Binding AllSelected}" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <Button Content="Mark Selected" Click="MarkSelected_Click" 
                    Style="{StaticResource ActionButton}" Background="#3498db"
                    Width="100" Margin="0,0,10,0"/>
            <Button Content="Import" Command="{Binding ImportCommand}"
                    Style="{StaticResource ActionButton}" Background="#4CAF50"
                    Width="100" Margin="0,0,10,0"/>
            <Button Content="Cancel" IsCancel="True" 
                    Style="{StaticResource ActionButton}" Background="#6c757d"
                    Width="100"/>
        </StackPanel>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="5" Value="{Binding ImportProgress}" Height="5" Margin="0,10,0,0" 
                     Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"
                     Background="#e0e0e0" Foreground="#4CAF50"/>
    </Grid>
</Window>