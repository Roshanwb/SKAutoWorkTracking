<Window x:Class="SKAuto.UI.Views.VehicleWorkOrdersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        Title="{loc:Translate WorkOrderView_WorkOrder}" 
        Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="CanResize" WindowStyle="None">

    <Window.Resources>
        <!-- DataGrid style without BasedOn to avoid sealing errors -->
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- Column header style (light background, bold) -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10">
                <Run Text="{loc:Translate WOForChassis}" />
                <Run Text="{Binding ChassisNumber}" />
        </TextBlock>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding WorkOrders}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Translate WorkOrderView_WorkOrder}" Binding="{Binding Id}" Width="Auto" MinWidth="70"/>
                <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_OrderDate}" Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy}" Width="Auto" MinWidth="100"/>
                <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_OrderType}" Binding="{Binding OrderType}" Width="*"/>
                <DataGridTextColumn Header="{loc:Translate WorkOrderDetailWindow_Status}" Binding="{Binding Status}" Width="Auto" MinWidth="90"/>
                <DataGridTextColumn Header="{loc:Translate MainWindow_Total}" Binding="{Binding TotalAmount, StringFormat=C}" Width="Auto" MinWidth="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" HorizontalAlignment="Right" Content="{loc:Translate ClientManagementView_Close}" Click="CloseButton_Click" 
                    Style="{StaticResource ActionButton}" Background="#6c757d"
                    Width="80" Margin="5"/>
    </Grid>
</Window>