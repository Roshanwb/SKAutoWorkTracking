<Window x:Class="SKAuto.UI.Views.TravelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Travel" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Travel Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Date:" Margin="0,5,0,0"/>
            <DatePicker x:Name="DatePicker" SelectedDate="{Binding TravelDate, UpdateSourceTrigger=PropertyChanged}" 
                        Margin="0,2,0,5"/>

            <TextBlock Text="Destination:" Margin="0,5,0,0"/>
            <TextBox x:Name="DestinationBox" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,2,0,5"/>

            <TextBlock Text="Distance (km):" Margin="0,5,0,0"/>
            <TextBox x:Name="DistanceBox" Text="{Binding DistanceKm, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,2,0,5"/>

            <TextBlock Text="Travel Cost (€):" Margin="0,5,0,0"/>
            <TextBox x:Name="CostBox" Text="{Binding TravelCost, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,2,0,5"/>

            <TextBlock Text="Notes:" Margin="0,5,0,0"/>
            <TextBox x:Name="NotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,2,0,5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Click="Ok_Click" Width="80" Margin="5" 
                    Style="{StaticResource ActionButton}" Background="#4CAF50"/>
            <Button Content="Cancel" Click="Cancel_Click" Width="80" Margin="5" 
                    Style="{StaticResource ActionButton}" Background="#6c757d"/>
        </StackPanel>
    </Grid>
</Window>