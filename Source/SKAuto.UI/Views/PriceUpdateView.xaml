<Window x:Class="SKAuto.UI.Views.PriceUpdateView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Translate MainWindow_BulkPriceUpdate}" Height="500" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
        </Style>
        <Style x:Key="StatusButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Translate MainWindow_BulkPriceUpdate}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Accessory selection -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{loc:Translate PriceUpdateView_Task}" Style="{StaticResource SectionHeader}" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Accessories}"
                          SelectedItem="{Binding SelectedAccessory}"
                          DisplayMemberPath="Name"
                          IsEditable="False"
                          Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Date range -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{loc:Translate PriceUpdateView_DateRange}" Style="{StaticResource SectionHeader}" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{loc:Translate PriceUpdateView_From}" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Margin="0,0,10,0"/>
                    <Label Grid.Column="2" Content="{loc:Translate PriceUpdateView_To}" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Margin="0,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- New price -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{loc:Translate PriceUpdateView_NewPrice}" Style="{StaticResource SectionHeader}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                <TextBlock Text="{loc:Translate PriceUpdateView_LeaveEmptyKeepPrice}" FontSize="10" Foreground="Gray" Margin="5,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Options -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <CheckBox Content="{loc:Translate PriceUpdateView_AlsoUpdateDefaultPrice}" IsChecked="{Binding UpdateDefaultPrice}" Margin="5,5,0,5"/>
        </Border>

        <!-- Status message -->
        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Foreground="#27ae60" Margin="0,10,0,5" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Translate PriceUpdateView_UpdatePrices}" Command="{Binding UpdateCommand}" Width="120" Margin="5"
                    Style="{StaticResource StatusButton}" Background="#27AE60"/>
            <Button Content="{loc:Translate ClientManagementView_Close}" Command="{Binding CloseCommand}" Width="80" Margin="5"
                    Style="{StaticResource StatusButton}" Background="#6C757D"/>
        </StackPanel>
    </Grid>
</Window>