<Window x:Class="SKAuto.UI.Views.ClientEditWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Translate ClientEditWindow_EditClient}" Height="450" Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="{loc:Translate ClientMergeDialog_Name}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Client.Name}" Margin="5" Padding="3" BorderBrush="#dee2e6"/>

        <Label Grid.Row="1" Grid.Column="0" Content="{loc:Translate ClientEditWindow_ClientCode}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Client.ClientCode}" Margin="5" Padding="3" BorderBrush="#dee2e6"/>

        <Label Grid.Row="2" Grid.Column="0" Content="{loc:Translate ClientEditWindow_Type}" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" 
                  ItemsSource="{Binding ClientTypes}"
                  SelectedItem="{Binding Client.Type}"
                  Margin="5" Height="30" Width="100"
                  HorizontalAlignment="Left"/>

        <Label Grid.Row="3" Grid.Column="0" Content="{loc:Translate ClientEditWindow_Address}" VerticalAlignment="Top" Margin="0,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Client.Address}" Margin="5" Padding="3" Height="60" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#dee2e6"/>

        <Label Grid.Row="4" Grid.Column="0" Content="{loc:Translate ClientMergeDialog_Phone}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Client.Phone}" Margin="5" Padding="3" BorderBrush="#dee2e6"/>

        <Label Grid.Row="5" Grid.Column="0" Content="{loc:Translate ClientMergeDialog_Email}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Client.Email}" Margin="5" Padding="3" BorderBrush="#dee2e6"/>

        <Label Grid.Row="6" Grid.Column="0" Content="{loc:Translate ClientMergeDialog_Notes}" VerticalAlignment="Top" Margin="0,5"/>
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Client.Notes}" Margin="5" Padding="3" Height="60" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#dee2e6"/>

        <Label Grid.Row="7" Grid.Column="0" Content="{loc:Translate ClientEditWindow_Active}" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding Client.IsActive}" Margin="5" VerticalAlignment="Center"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="{loc:Translate VehicleEditWindow_Save}" Command="{Binding SaveCommand}" 
                    Style="{StaticResource ActionButton}" Background="#4CAF50"
                    Width="80" Height="30" Margin="5"/>
            <Button Content="{loc:Translate VehicleEditWindow_Cancel}" Command="{Binding CancelCommand}" 
                    Style="{StaticResource ActionButton}" Background="#6c757d"
                    Width="80" Height="30" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>