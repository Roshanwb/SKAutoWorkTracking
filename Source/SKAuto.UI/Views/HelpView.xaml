<Window x:Class="SKAuto.UI.Views.HelpView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Translate HelpView_Title}" Height="650" Width="850"
        WindowStartupLocation="CenterOwner" 
        Background="#F8F9FA"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SubHeader">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="BodyText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,0,0,10"/>
        </Style>
        <Style TargetType="BulletDecorator" x:Key="BulletItem">
            <Setter Property="Margin" Value="10,2,0,2"/>
        </Style>
        <Style TargetType="Border" x:Key="TipBox">
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="BorderBrush" Value="#FFB74D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="10,5,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{loc:Translate HelpView_HelpDocumentationTab}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="{loc:Translate HelpView_UserGuide}" FontSize="16" Foreground="#7F8C8D" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
        </StackPanel>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" BorderBrush="#DEE2E6" BorderThickness="1" Background="White" Margin="0,0,0,10">
            <TabItem Header="{loc:Translate HelpView_GettingStartedTab}">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate HelpView_Welcome}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{loc:Translate HelpView_WelcomeDescription}" Style="{StaticResource BodyText}"/>

                        <TextBlock Text="{loc:Translate HelpView_QuickStartTopic}" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_LaunchApp}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_TodayWorkOrders}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_UseMainMenu}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="{loc:Translate HelpView_DailyWorkflowTopic}" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="{loc:Translate HelpView_Morning}" FontWeight="SemiBold" Margin="10,8,0,2"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_CheckPlannedWork}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_ImportNewFiles}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_PrintWorkSheets}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="{loc:Translate HelpView_DuringTheDay}" FontWeight="SemiBold" Margin="10,8,0,2"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_UpdateStatusDescription}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_AddNotesTravel}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="{loc:Translate HelpView_EndOfDay}" FontWeight="SemiBold" Margin="10,8,0,2"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_MarkDone}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_GenerateDailyReports}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text=". " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_UploadReportsToDrive}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Translate HelpView_ImportingDataTab}">
