                            </BulletDecorator.Bullet>
                            <TextBlock Text="{loc:Translate HelpView_ImportAllVehiclesClients}" Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
