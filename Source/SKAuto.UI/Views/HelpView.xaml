<Window x:Class="SKAuto.UI.Views.HelpView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help – SKAuto Work Tracking" Height="650" Width="850"
        WindowStartupLocation="CenterOwner" 
        Background="#F8F9FA"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SubHeader">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="BodyText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,0,0,10"/>
        </Style>
        <Style TargetType="BulletDecorator" x:Key="BulletItem">
            <Setter Property="Margin" Value="10,2,0,2"/>
        </Style>
        <Style TargetType="Border" x:Key="TipBox">
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="BorderBrush" Value="#FFB74D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="10,5,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="📘 Help &amp; Documentation" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="  –  User Guide" FontSize="16" Foreground="#7F8C8D" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
        </StackPanel>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" BorderBrush="#DEE2E6" BorderThickness="1" Background="White" Margin="0,0,0,10">
            <TabItem Header="🚀 Getting Started">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Welcome to SKAuto Work Tracking" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="This system helps you manage work orders for vehicle accessory fitting and preparation. Below is a quick overview of the main workflows." Style="{StaticResource BodyText}"/>

                        <TextBlock Text="🔹 Quick Start" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Launch the app from desktop or system tray." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Today's work orders load automatically." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Use the main menu to import data, manage clients/vehicles, or generate reports." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Daily Workflow" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="Morning (8:00–9:00)" FontWeight="SemiBold" Margin="10,8,0,2"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Check today's planned work (dashboard)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Import any new files (Excel/CSV, ParcCarrières, or PDF folder)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Print work sheets for mechanics (via reports)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="During the Day" FontWeight="SemiBold" Margin="10,8,0,2"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Update work order status (Planned → In Progress → Done)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Add notes or travel records as needed." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="End of Day (16:00–17:00)" FontWeight="SemiBold" Margin="10,8,0,2"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Mark all completed work as 'Done'." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Generate daily reports (Excel/PDF)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Optionally upload reports to Google Drive." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📥 Importing Data">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Import Work Orders" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="The system supports several import methods. Each has specific use cases." Style="{StaticResource BodyText}"/>

                        <TextBlock Text="🔹 Excel / CSV (General)" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="Use this for most imports. It reads the ParcCarrières or similar CSV format." Style="{StaticResource BodyText}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Supports columns: N° (VIN), Client, Modèle, Fin prép., Etat." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="All vehicles and clients are imported regardless of Etat or date." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Work orders are created only for rows with Etat = 'Prêt' and date within the selected range." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 ParcCarrières CSV" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="Dedicated parser for the standard ParcCarrières export. Same logic as above but optimized for that format." Style="{StaticResource BodyText}"/>

                        <TextBlock Text="🔹 PDF Folder" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="Select a folder containing PDF work orders. The built‑in Python extractor reads the data." Style="{StaticResource BodyText}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Requires pdf_accessories_extractor.py in the app folder." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Imports all rows; work orders are created with status = Planned." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Import Vehicles Only" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="Use the 'Import Vehicles' button in the Vehicle Management window." Style="{StaticResource BodyText}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Imports VIN, Model, and Client from the same CSV format." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Creates new clients (cleaned name) and links vehicles to them." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Skips existing VINs. Date and Etat are ignored." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <Border Style="{StaticResource TipBox}">
                            <TextBlock Text="💡 Tip: Use the 'Dry Run' checkbox to preview what will be imported without making changes." Style="{StaticResource BodyText}" Margin="0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📋 Work Orders">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Managing Work Orders" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Work orders are the core of the system. Each work order represents all work for a specific vehicle on a specific date." Style="{StaticResource BodyText}"/>

                        <TextBlock Text="🔹 Creating a Work Order" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Click 'New Work Order' on the dashboard." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Search for a vehicle by chassis number or register a new one." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Add tasks (accessories) – type, quantity, price, and time." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Add travel records (destination, distance, cost) if applicable." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Editing &amp; Deleting" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Click the '✏️' button in the main grid to edit a work order." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Delete from the work order detail window or via the 'Delete' button (admin only)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Status Tracking" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Planned → In Progress → Blocked → Done." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Marking as 'Done' automatically sets the completion date." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <Border Style="{StaticResource TipBox}">
                            <TextBlock Text="💡 Tip: You can quickly mark a work order as 'Done' directly from the main grid using the green button." Style="{StaticResource BodyText}" Margin="0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📊 Reporting">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Generating Reports" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="The Reports window provides powerful filtering and export to Excel or PDF." Style="{StaticResource BodyText}"/>

                        <TextBlock Text="🔹 Report Types" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Work Orders – detailed list with tasks and travel." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Tasks – all accessories with type, price, and usage count." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Clients – list of all clients with contact details." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Vehicles – list of all vehicles with client association." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Filters (Work Orders &amp; Tasks)" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Date range, task type, work status, specific accessory." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Group by Week (combines orders by week)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Group by Task Type (for Tasks report)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Summary Only – hides task-level details, shows only totals." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Export Options" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Excel (.xlsx) – editable, pivot‑ready." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="PDF (.pdf) – printable, client‑friendly." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <Border Style="{StaticResource TipBox}">
                            <TextBlock Text="💡 Tip: PDF reports use your custom colors and fonts (set in Settings)." Style="{StaticResource BodyText}" Margin="0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⚙️ Data Management">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Managing Clients, Vehicles, and Accessories" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="🔹 Clients" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Add, edit, or delete clients in the Client Management window." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Merge duplicate clients: select multiple clients and click 'Merge'." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="All vehicles linked to the source clients are automatically reassigned to the master client." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Vehicles" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Search, add, edit, or delete vehicles." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Import vehicles directly from CSV using the 'Import Vehicles' button." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Accessories (Tasks)" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Define tasks with name, part number, price, time, and task type (Fit, Sell, Remove, Preparation, Travel, Other)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Bulk Price Update: change the price for a specific accessory across a date range." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Bulk Price Update" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Open from the main menu → Bulk Price Update." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Select an accessory, date range, and new price." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Optionally update the accessory's default price." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="💾 Backup &amp; Restore">
                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Protect Your Data" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="The Backup &amp; Restore window offers multiple ways to safeguard your database." Style="{StaticResource BodyText}"/>

                        <TextBlock Text="🔹 Local Backup" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Creates a .db copy in your chosen folder." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Automatic backup on application exit (if user was logged in)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Keep only the latest N backups (configurable)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Export to ZIP (CSV)" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Exports all tables as CSV files in a ZIP archive." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Portable – can be restored on any machine." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>

                        <TextBlock Text="🔹 Google Drive Sync" Style="{StaticResource SubHeader}"/>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Configure your Google Drive Client ID and Secret in Settings." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="Auto-authenticate on startup (if configured)." Style="{StaticResource BodyText}" Margin="0"/>
                        </BulletDecorator>
                        <BulletDecorator Style="{StaticResource BulletItem}">
                            <BulletDecorator.Bullet>
                                <TextBlock Text="• " FontWeight="Bold"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="List, upload, and restore backups directly from Drive." Style="{StaticResource BodyText}" Margin="0"/>
