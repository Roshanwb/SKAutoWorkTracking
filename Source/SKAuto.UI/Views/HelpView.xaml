<Window x:Class="SKAuto.UI.Views.HelpView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help - SKAuto Work Tracking" Height="500" Width="700"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Help &amp; Documentation" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">
            <TabItem Header="Getting Started">
                <ScrollViewer Margin="5">
                    <StackPanel>
                        <TextBlock Text="1. Import Work Orders" FontWeight="Bold" Margin="0,5,0,5"/>
                        <TextBlock Text="Use the 'Import' button to load data from PDF, Excel, or ParcCarrières CSV. Select the appropriate file type and follow the prompts." TextWrapping="Wrap" Margin="10,0,0,10"/>

                        <TextBlock Text="2. Manage Clients and Vehicles" FontWeight="Bold" Margin="0,5,0,5"/>
                        <TextBlock Text="Use the 'Manage' menu to add, edit, or delete clients and vehicles." TextWrapping="Wrap" Margin="10,0,0,10"/>

                        <TextBlock Text="3. Create Work Orders" FontWeight="Bold" Margin="0,5,0,5"/>
                        <TextBlock Text="Click 'New Work Order' to manually create an order. Fill in client, vehicle, and task details." TextWrapping="Wrap" Margin="10,0,0,10"/>

                        <TextBlock Text="4. Generate Reports" FontWeight="Bold" Margin="0,5,0,5"/>
                        <TextBlock Text="Use the 'Reports' menu to generate Excel or PDF reports with various filters." TextWrapping="Wrap" Margin="10,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Import Tips">
                <ScrollViewer Margin="5">
                    <StackPanel>
                        <TextBlock Text="PDF Import" FontWeight="Bold" Margin="0,5,0,5"/>
                        <TextBlock Text="Place all PDF files in one folder. The system will extract order data automatically." TextWrapping="Wrap" Margin="10,0,0,10"/>

                        <TextBlock Text="Excel/CSV Import" FontWeight="Bold" Margin="0,5,0,5"/>
                        <TextBlock Text="Files must contain columns: Date, Chassis, Model, Client. Date format should be MM/dd/yyyy." TextWrapping="Wrap" Margin="10,0,0,10"/>

                        <TextBlock Text="ParcCarrières CSV" FontWeight="Bold" Margin="0,5,0,5"/>
                        <TextBlock Text="Only rows with state 'Livré' or 'Préparé' and date after 31/12/2025 are imported." TextWrapping="Wrap" Margin="10,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer Margin="5">
                    <StackPanel>
                        <TextBlock Text="Report Colors and Fonts" FontWeight="Bold" Margin="0,5,0,5"/>
                        <TextBlock Text="Go to Settings → Report Settings to customize the look of PDF reports." TextWrapping="Wrap" Margin="10,0,0,10"/>

                        <TextBlock Text="Backup" FontWeight="Bold" Margin="0,5,0,5"/>
                        <TextBlock Text="Use the Backup menu to create local backups or sync with Google Drive." TextWrapping="Wrap" Margin="10,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="About">
                <StackPanel Margin="5" VerticalAlignment="Center">
                    <TextBlock Text="SKAuto Work Tracking System" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Version 1.0.0" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Developed by SK Auto" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="2026 - Insights®" HorizontalAlignment="Center" FontSize="11" Foreground="#7F8C8D" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Close button -->
        <Button Grid.Row="2" Content="Close" Width="80" HorizontalAlignment="Right" Margin="0,15,0,0"
                Click="CloseButton_Click" Style="{StaticResource StatusButton}" Background="#6C757D"/>
    </Grid>
</Window>