<Window x:Class="SKAuto.UI.Views.ClientMergeDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Translate ClientMergeDialog_MergeClients}" Height="500" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Translate ClientMergeDialog_EditMasterClient}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Translate ClientMergeDialog_Name}" Margin="0,5,0,0"/>
                <TextBox x:Name="txtName" Margin="0,2,0,5"/>

                <TextBlock Text="{loc:Translate ClientMergeDialog_Phone}" Margin="0,5,0,0"/>
                <TextBox x:Name="txtPhone" Margin="0,2,0,5"/>

                <TextBlock Text="{loc:Translate ClientMergeDialog_Email}" Margin="0,5,0,0"/>
                <TextBox x:Name="txtEmail" Margin="0,2,0,5"/>

                <TextBlock Text="{loc:Translate ClientEditWindow_Address}" Margin="0,5,0,0"/>
                <TextBox x:Name="txtAddress" Margin="0,2,0,5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="{loc:Translate ClientMergeDialog_Notes}" Margin="0,5,0,0"/>
                <TextBox x:Name="txtNotes" Margin="0,2,0,5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <CheckBox x:Name="chkActive" Content="{loc:Translate VehicleManagementView_Active}" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Translate ClientMergeDialog_OK}" Click="Ok_Click" Width="80" Margin="5" Style="{StaticResource ActionButton}" Background="#4CAF50"/>
            <Button Content="{loc:Translate VehicleEditWindow_Cancel}" Click="Cancel_Click" Width="80" Margin="5" Style="{StaticResource ActionButton}" Background="#6c757d"/>
        </StackPanel>
    </Grid>
</Window>