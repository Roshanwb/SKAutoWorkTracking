<Window x:Class="SKAuto.UI.Views.SettingsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="{loc:Translate MainWindow_Settings}" Height="850" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>
            <Setter Property="Margin" Value="{DynamicResource CardMargin}"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Translate Settings_Title}" FontSize="18" FontWeight="Bold" 
                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,15"/>

        <!-- Language -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="{loc:Translate Settings_Language}" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" Margin="5"/>
            </StackPanel>
        </Border>

        <!-- Theme -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="{loc:Translate Settings_Theme}" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" Margin="5"/>
            </StackPanel>
        </Border>

        <!-- Report Colors -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="{loc:Translate Settings_ReportColors}" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="{loc:Translate Settings_HeaderBackground}" Margin="5"/>
                    <Button Grid.Row="0" Grid.Column="1" Margin="5" Padding="5" 
                            Content="{Binding HeaderBackground}" 
                            Command="{Binding PickColorCommand}" CommandParameter="HeaderBackground"
                            Background="{Binding HeaderBackground, Converter={StaticResource StringToBrush}}"
                            Foreground="White"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="{loc:Translate Settings_HeaderText}" Margin="5"/>
                    <Button Grid.Row="1" Grid.Column="1" Margin="5" Padding="5" 
                            Content="{Binding HeaderForeground}" 
                            Command="{Binding PickColorCommand}" CommandParameter="HeaderForeground"
                            Background="{Binding HeaderForeground, Converter={StaticResource StringToBrush}}"
                            Foreground="White"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="{loc:Translate Settings_AlternateRow}" Margin="5"/>
                    <Button Grid.Row="2" Grid.Column="1" Margin="5" Padding="5" 
                            Content="{Binding AlternateRowBackground}" 
                            Command="{Binding PickColorCommand}" CommandParameter="AlternateRowBackground"
                            Background="{Binding AlternateRowBackground, Converter={StaticResource StringToBrush}}"
                            Foreground="White"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="{loc:Translate Settings_Border}" Margin="5"/>
                    <Button Grid.Row="3" Grid.Column="1" Margin="5" Padding="5" 
                            Content="{Binding BorderColor}" 
                            Command="{Binding PickColorCommand}" CommandParameter="BorderColor"
                            Background="{Binding BorderColor, Converter={StaticResource StringToBrush}}"
                            Foreground="White"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="{loc:Translate Settings_TotalBackground}" Margin="5"/>
                    <Button Grid.Row="4" Grid.Column="1" Margin="5" Padding="5" 
                            Content="{Binding TotalBackground}" 
                            Command="{Binding PickColorCommand}" CommandParameter="TotalBackground"
                            Background="{Binding TotalBackground, Converter={StaticResource StringToBrush}}"
                            Foreground="White"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="{loc:Translate Settings_Accent}" Margin="5"/>
                    <Button Grid.Row="5" Grid.Column="1" Margin="5" Padding="5" 
                            Content="{Binding AccentColor}" 
                            Command="{Binding PickColorCommand}" CommandParameter="AccentColor"
                            Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}"
                            Foreground="White"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Report Fonts -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="{loc:Translate Settings_ReportFonts}" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="{loc:Translate Settings_FontFamily}" Margin="5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="5" 
                              ItemsSource="{Binding FontFamilies}" 
                              SelectedItem="{Binding FontFamily}"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="{loc:Translate Settings_HeaderSize}" Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Text="{Binding HeaderFontSize}"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="{loc:Translate Settings_NormalSize}" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding NormalFontSize}"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="{loc:Translate Settings_TitleSize}" Margin="5"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="5" Text="{Binding TitleFontSize}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Translate VehicleEditWindow_Save}" Command="{Binding SaveCommand}" Width="80" Margin="5" 
                    Style="{StaticResource ActionButton}" Background="{DynamicResource SuccessBrush}"/>
            <Button Content="{loc:Translate VehicleEditWindow_Cancel}" Command="{Binding CancelCommand}" Width="80" Margin="5" 
                    Style="{StaticResource ActionButton}" Background="{DynamicResource ButtonSecondaryBackground}"/>
        </StackPanel>
    </Grid>
</Window>