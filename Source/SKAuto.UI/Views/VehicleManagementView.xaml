<Window x:Class="SKAuto.UI.Views.VehicleManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Vehicles" Height="550" Width="950"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Panel -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="5" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search Chassis:" VerticalAlignment="Center" Margin="5,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="250" Height="30" Margin="5" 
                         BorderBrush="#dee2e6" Padding="5,0,0,0"/>
                <TextBlock Text="(type to filter)" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredVehicles}" SelectedItem="{Binding SelectedVehicle}"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                  BorderBrush="#dee2e6" BorderThickness="1"
                  RowBackground="#ffffff" AlternatingRowBackground="#f8f9fa">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Chassis" Binding="{Binding ChassisNumber}" Width="150" SortDirection="Ascending"/>
                <DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="80"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="60"/>
                <DataGridTextColumn Header="Reg" Binding="{Binding Registration}" Width="80"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add" Command="{Binding AddVehicleCommand}" 
                    Style="{StaticResource ActionButton}" Background="#4CAF50"
                    Width="80" Margin="5"/>
            <Button Content="Edit" Command="{Binding EditVehicleCommand}" 
                    Style="{StaticResource ActionButton}" Background="#3498db"
                    Width="80" Margin="5"/>
            <Button Content="Delete" Command="{Binding DeleteVehicleCommand}" 
                    Style="{StaticResource ActionButton}" Background="#dc3545"
                    Width="80" Margin="5"/>
            <Button Content="Close" Command="{Binding CloseCommand}" 
                    Style="{StaticResource ActionButton}" Background="#6c757d"
                    Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>