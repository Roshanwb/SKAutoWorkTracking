<Window x:Class="SKAuto.UI.Views.VehicleManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SKAuto.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SKAuto.UI.Converters"
        Title="{loc:Translate VehicleManagementView_ManageVehicles}" Height="550" Width="950"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Panel -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="5" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Translate VehicleManagementView_ImportVehicles}" Command="{Binding ImportVehiclesCommand}" 
                        Style="{StaticResource ActionButton}" Background="#28a745"
                        Width="120" Margin="0,0,15,0"/>
                <TextBlock Text="{loc:Translate VehicleManagementView_SearchChassis}" VerticalAlignment="Center" Margin="5,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="250" Height="30" Margin="5" 
                         BorderBrush="#dee2e6" Padding="5,0,0,0"/>
                <TextBlock Text="{loc:Translate ClientManagementView_TypeToFilter}" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredVehicles}" SelectedItem="{Binding SelectedVehicle}"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                  BorderBrush="#dee2e6" BorderThickness="1"
                  RowBackground="#ffffff" AlternatingRowBackground="#f8f9fa">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Translate MainWindow_ID}" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="{loc:Translate MainWindow_Chassis}" Binding="{Binding ChassisNumber}" Width="150" SortDirection="Ascending"/>
                <DataGridTextColumn Header="{loc:Translate VehicleManagementView_Make}" Binding="{Binding Make}" Width="80"/>
                <DataGridTextColumn Header="{loc:Translate VehicleManagementView_Model}" Binding="{Binding Model}" Width="100"/>
                <DataGridTextColumn Header="{loc:Translate VehicleManagementView_Year}" Binding="{Binding Year}" Width="60"/>
                <DataGridTextColumn Header="{loc:Translate VehicleManagementView_Reg}" Binding="{Binding Registration}" Width="80"/>
                <DataGridCheckBoxColumn Header="{loc:Translate VehicleManagementView_Active}" Binding="{Binding IsActive}" Width="60"/>

                <!-- NEW: Lookup button column -->
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="⌕" 
                                    Command="{Binding DataContext.ShowVehicleWorkOrdersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding ChassisNumber}"
                                    Background="Transparent" BorderThickness="0" Foreground="#4CAF50"
                                    FontSize="14" Cursor="Hand" 
                                    ToolTip="{loc:Translate VehicleManagementView_ShowWorkOrders}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Translate MainWindow_Notes}" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Progress section -->
        <StackPanel Grid.Row="2" Margin="0,5,0,5">
            <TextBlock Text="{Binding CurrentOperation}" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
            <ProgressBar Value="{Binding ImportProgress}" Height="5" 
                         Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"
                         Background="#e0e0e0" Foreground="#4CAF50"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Translate UserManagementView_Add}" Command="{Binding AddVehicleCommand}" 
                    Style="{StaticResource ActionButton}" Background="#4CAF50"
                    Width="80" Margin="5"/>
            <Button Content="{loc:Translate MainWindow_Edit}" Command="{Binding EditVehicleCommand}" 
                    Style="{StaticResource ActionButton}" Background="#3498db"
                    Width="80" Margin="5"/>
            <Button Content="{loc:Translate ClientManagementView_Delete}" Command="{Binding DeleteVehicleCommand}" 
                    Style="{StaticResource ActionButton}" Background="#dc3545"
                    Width="80" Margin="5"/>
            <Button Content="{loc:Translate ClientManagementView_Close}" Command="{Binding CloseCommand}" 
                    Style="{StaticResource ActionButton}" Background="#6c757d"
                    Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>