<Window x:Class="SKAuto.UI.Views.Splash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SKAuto Work Tracking" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="550" Height="350">
    <Window.Resources>
        <Storyboard x:Key="FadeOut" Duration="0:0:0.3">
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="#FFFFFF" CornerRadius="12" BorderBrush="#2C3E50" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <!-- Logo (adjust path if needed) -->
                <Image Width="448" Height="160" Margin="0,0,0,20" 
                       RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Source="/Views/logo.png"/>

                <TextBlock Text="Work Tracking System" FontSize="22" FontWeight="SemiBold" Foreground="#2C3E50" 
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <TextBlock Text="PSA Certified Partner" FontSize="14" Foreground="#7F8C8D" 
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock x:Name="StatusText" Text="Initializing..." FontSize="12" Foreground="#7F8C8D" 
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>

                <!-- Progress ring -->
                <Border Width="24" Height="24" CornerRadius="12" Background="Transparent" Margin="0,10,0,0"
                        HorizontalAlignment="Center">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Border.RenderTransform>
                        <RotateTransform CenterX="12" CenterY="12"/>
                    </Border.RenderTransform>
                    <Ellipse Width="20" Height="20" Stroke="#4CAF50" StrokeThickness="2" 
                             StrokeDashArray="4 4" RenderTransformOrigin="0.5,0.5"/>
                </Border>
            </StackPanel>

            <!-- Company text at bottom -->
            <TextBlock Grid.Row="1" Text="2026 - Insights®" FontSize="11" Foreground="#95A5A6" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>
        </Grid>
    </Border>
</Window>