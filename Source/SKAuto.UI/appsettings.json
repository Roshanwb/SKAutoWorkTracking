{
  "Database": {
    "Path": "%APPDATA%\\SKAuto\\SKAuto.db",
    "BackupPath": "%USERPROFILE%\\Documents\\SKAuto\\Backups",
    "BackupDays": 7
  },
  "Reports": {
    "TemplatePath": "Templates",
    "OutputPath": "%USERPROFILE%\\Documents\\SKAuto\\Reports",
    "AutoOpenAfterGenerate": true
  },
  "Import": {
    "DefaultImportPath": "%USERPROFILE%\\Documents\\SKAuto\\Imports",
    "AutoValidate": true,
    "KeepSourceFiles": true
  },
  "Security": {
    "EncryptPSARates": true,
    "RequirePasswordForPSA": true
  },
  "UI": {
    "Theme": "Light",
    "Language": "en-US",
    "DefaultView": "Today"
  }
}