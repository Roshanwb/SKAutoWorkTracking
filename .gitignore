# Azure / cloud
csx/
*.build.csdef
ecf/
rcf/

# Web / frontend / node
node_modules/
ClientBin/
wwwroot/        # uncomment if you want to track generated static files
.sass-cache/

# IDE / extensions / plugins
_ReSharper*/
