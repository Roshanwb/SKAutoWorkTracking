x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
project.lock.json
project.fragment.lock.json

# Visual Studio cache / local settings
.vs/
Generated\ Files/
.vspscc
.vssscc

# Files built by Visual Studio / compilers / linkers
