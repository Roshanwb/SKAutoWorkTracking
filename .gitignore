# === Visual Studio / .NET (strict, recursive) ===
# Editor and IDE
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs
*.dotSettings.user

# Build outputs - ignore everywhere
**/bin/
**/obj/
**/packages/
**/artifacts/
**/out/
**/publish/
**/dist/
**/Build/
**/[Bb]in/
**/[Oo]bj/
**/[Bb]uild*/
**/[Dd]ebug*/
**/[Rr]elease*/

# Common platform folders
node_modules/
wwwroot/           # comment out if you intentionally commit generated static files

# MSBuild / NuGet
project.assets.json
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets
packages.config
packages/
!**/packages/**/build/     # allow build targets if intentionally checked in

# Temporary / intermediate / compilation
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.builds
*.binlog

# Test and coverage
TestResults/
[Tt]est[Rr]esult*/
*.trx
coverage/
coverage*.json
coverage*.xml
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/

# Rider
.idea/
*.sln.iml
*.iml
.idea_modules/

# ReSharper / JetBrains
_ReSharper*/
*.DotSettings.user
*.DotSettings

# Mono / Xamarin
*.userprefs
*.mdb

# Visual C++ caches
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.VC.db

# Publish / deployment artifacts
*.Publish.xml
*.pubxml
*.azurePubxml
PublishScripts/
AppPackages/
BundleArtifacts/
*.appx
*.appxbundle
*.appxupload
*.publishsettings

# Azure / cloud
csx/
*.build.csdef
ecf/
rcf/

# Logs, db and other local data
*.log
*.sql
*.sqlite
*.sqlite3
*.db
*.db-journal
*.mdf
*.ldf

# Secrets / certs / keys
*.pfx
*.snk
*.key
*.pem
*.der
*.publishsettings

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Generated code / backups
Generated_Code/
Generated\ Files/
**/*GeneratedArtifacts*/
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# Profiling / dumps
*.dmp
*.mdmp
*.psess
*.vsp
*.vspx

# Coverage / profiling tools
.opencover/
.coverage
*.coverage

# Force-ignore patterns (ensure directories ignored even if empty)
.vs/*
**/.vs/*
**/bin/*
**/obj/*
**/Debug/*
**/debug/*
**/Release/*
**/release/*

# Per-solution or per-project explicit exceptions (uncomment/edit as needed)
# !/path/to/explicitly/tracked/file
# !**/wwwroot/keepfile

# End - minimal follow-up commands:
# After replacing .gitignore run:
# git rm -r --cached .
# git add .
# git commit -m "Apply strict .gitignore"
