.vs/
.vscode/
.vsconfig
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs
mono_crash.*

# Build output
[Bb]in/
[Oo]bj/
build/
Build/
[Bb]uild*/
[Dd]ebug*/
[Dd]ebug*/
[Rr]elease*/
[Rr]eleases*/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
artifacts/
artifacts/**

# MSBuild / tooling files
.project.lock.json
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets
packages/
**/[Pp]ackages/*
!**/[Pp]ackages/build/
packages/**

