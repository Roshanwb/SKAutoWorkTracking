nCrunchTemp_*
_Tf/
.TeamCity
.mfractor/
.ionide/

# User / OS files
$RECYCLE.BIN/
Thumbs.db
ehthumbs.db
.DS_Store
Desktop.ini
~$*
*~

# Generated code / backups / logs
Generated_Code/
Generated\ Files/
**/*GeneratedArtifacts*/
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
MigrationBackup/
*.rptproj.bak
*.dbmdl
*.dbproj.schemaview

# Database / SQL
*.mdf
*.ldf
*.ndf
App_Data/*.mdf
App_Data/*.ldf

# Secrets / certificates / keys
*.pfx
*.snk
*.publishsettings

# Misc
.orleans.codegen.cs
*.plg
*.opt
*.vbw
*.bin
*.nvuser
.localhistory/
Healthchecksdb
OpenCover/

# Ensure Git ignores these folders even if empty
.vs/*
[Bb]in/*
[Oo]bj/*
build/*

# Force ignore for common problematic directories
**/.vs/
**/bin/
**/obj/
**/build/
**/Debug/
**/debug/
**/Release/
**/release/

