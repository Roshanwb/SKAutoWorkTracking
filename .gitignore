coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# Visual C++ / caches / DBs
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb
*.cachefile

